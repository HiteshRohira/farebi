# Created by `pnpm dev:backend` after connecting a Convex deployment.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Shoo derives this from the browser origin by default. Convex needs the same
# audience to verify Shoo identity tokens. Set it in the Convex dashboard too.
SHOO_CLIENT_ID=origin:http://localhost:3000

# Multi-user localhost testing is enabled with Convex deployment variables,
# not Vite variables. See README.md before enabling it.
